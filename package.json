{
  "name": "dsh-rosemary-memory",
  "version": "0.3.0",
  "description": "Auditable cross-session memory for DeepSeek Harness: digest finished turns into runs and notes deterministically, compress them by explainable weights, recall them by exact match in any session. No server, no model calls, no vectors.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./public/*": "./public/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "docs",
    "scripts/smoke.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dsh.bundle.patch.yml",
    "icon.svg",
    "package.json"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "cross-session-memory",
    "rag",
    "context",
    "rosemary"
  ],
  "author": "HZY",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HZYqwq/dsh-rosemary-memory.git"
  },
  "homepage": "https://github.com/HZYqwq/dsh-rosemary-memory#readme",
  "bugs": {
    "url": "https://github.com/HZYqwq/dsh-rosemary-memory/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
